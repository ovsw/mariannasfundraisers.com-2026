# Required local identity and Sanity connection values.
NEXT_PUBLIC_SITE_NAME="Marianna's Fundraisers"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-23
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
OG_IMAGE_SECRET=generate-a-long-random-value
SANITY_API_READ_TOKEN=your-read-token
# Lets the Sanity Function that refreshes content on publish call the
# Website. Only the deployed Website needs it; see docs/deployment.md.
SANITY_REVALIDATE_SECRET=
# Each Website form posts to its own Formspark form (docs/agents/form-notifications.md).
# "echo" is Formspark's test form: the form works and nobody gets an email.
# The production build fails while one is missing or still "echo".
FORMSPARK_CONTACT_FORM_ID=echo
FORMSPARK_TASTING_FORM_ID=echo
FORMSPARK_FIND_A_SALE_FORM_ID=echo

# Optional editor tooling.
SHADCNBLOCKS_API_KEY=your-key
