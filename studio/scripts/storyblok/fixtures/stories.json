         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "attrs": {
             "textAlign": null
            },
            "content": [
             {
              "text": "Request ",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": "all",
              "type": "text"
             },
             {
              "text": " Order Forms",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": " ",
              "type": "text"
             },
             {
              "text": "back",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": " from your sellers",
              "type": "text"
             },
             {
              "text": " Ten days before ",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": "your scheduled Delivery Date, or earlier if you feel it's needed.  Then, tally your orders using our ",
              "type": "text"
             },
             {
              "text": "Order Tally Spreadsheet.",
              "type": "text",
              "marks": [
               {
                "type": "link",
                "attrs": {
                 "href": "/documents-and-forms",
                 "uuid": "f23baae3-6d33-48a5-b582-b75402ab2d3c",
