        "title": null,
        "filename": "https://a.storyblok.com/f/133593/2400x1602/fb09cdecd2/slicing-machine-close-up.jpg",
        "copyright": null,
        "fieldtype": "asset"
       },
       "content": [
        {
         "_uid": "94806b9a-fd2f-4154-8fa1-50883bc222f7",
         "title": "Hoagies",
         "eyebrow": "Famous",
         "anchor_id": "",
         "component": "heading-group"
        },
        {
         "_uid": "147d3d56-4925-4384-8f1e-3c5a233deb34",
         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "content": [
             {
              "text": "Our team chooses only the best quality meats and cheeses that are sliced in-house each morning before hoagie assembly. ",
              "type": "text"
             }
            ]
           },
           {
            "type": "paragraph",
            "content": [
             {
              "text": "Each ",
              "type": "text"
             },
             {
              "text": "hoagie",
              "type": "text",
              "marks": [
               {
                "type": "link",
                "attrs": {
                 "href": "/menu/",
                 "uuid": "fa6265db-3dfc-41bd-bdda-910c42723ef6",
                 "anchor": "hoagies",
                 "target": null,
                 "linktype": "story"
                }
               }
              ]
             },
             {
              "text": " comes with shredded Lettuce, sliced Tomatoes, and diced Onions (except Ham Club - no onions). ",
              "type": "text"
             }
            ]
           },
           {
            "type": "paragraph",
            "content": [
             {
              "text": "The vegetables are vacuum sealed individually at our facility to maximize freshness and taste. This process also keeps our hoagies from mixing in flavors that you may not want. The customer chooses which toppings to enjoy on their hoagie.",
              "type": "text"
             }
            ]
           },
           {
            "type": "paragraph",
            "content": [
             {
              "text": "Our condiments have become a fan favorite of many customers. Our homemade Italian Dressing and Sweet and Sassy Mayo are the perfect compliments to our hoagies.",
              "type": "text"
             }
            ]
           }
          ]
         },
         "component": "rich-text-basic"
        }
       ],
       "component": "row-big-image",
