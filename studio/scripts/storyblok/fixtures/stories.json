         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "content": [
             {
              "text": "See our ",
              "type": "text"
             },
             {
              "text": "Pricing Info Page",
              "type": "text",
              "marks": [
               {
                "type": "link",
                "attrs": {
