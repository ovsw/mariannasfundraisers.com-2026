         "icon": "paper-plane",
         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "content": [
             {
              "text": "Eight business days before ",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": "your Delivery Date, ",
              "type": "text"
             },
             {
              "text": "submit your order here",
              "type": "text",
              "marks": [
               {
                "type": "link",
                "attrs": {
                 "href": "/submit-your-order",
                 "uuid": "10047fdc-54b0-414a-9a26-b25566ee2b5a",
                 "anchor": null,
                 "target": null,
                 "linktype": "story"
                }
               }
              ]
             },
             {
              "text": ", or at ",
              "type": "text"
             },
             {
              "text": "mariannas@delgrossos.com",
              "type": "text",
              "marks": [
               {
                "type": "link",
                "attrs": {
                 "href": "mariannas@delgrossos.com",
