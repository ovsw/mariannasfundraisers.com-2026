         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "content": [
             {
              "text": "Order Forms and Sale Confirmation will be ",
              "type": "text"
             },
             {
              "text": "mailed out",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": " to you via USPS 3-Day Priority. These will come in handy in the next step.",
              "type": "text"
             }
            ]
           }
          ]
         },
