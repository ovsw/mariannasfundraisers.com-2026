         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "content": [
             {
              "text": "On your Delivery Date, be ready to receive your order. ",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": "This final step is an important one, please read our guide on ",
              "type": "text"
             },
             {
              "text": "how to prepare for receiving a shipment",
              "type": "text",
              "marks": [
               {
                "type": "link",
