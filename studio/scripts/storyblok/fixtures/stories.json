                 "target": null,
                 "linktype": "story"
                }
               }
              ]
             },
             {
              "text": " for information on item costs and ",
              "type": "text"
             },
             {
              "text": "helpful resources",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": " on how to decide on your Selling Price. ",
              "type": "text"
             }
            ]
           }
          ]
         },
         "heading": "Decide on your Selling Price",
         "component": "feature-group",
         "heading_level": "h3"
        },
        {
         "_uid": "217076f9-3d13-4cc9-b69d-d4669bb25dbd",
         "icon": "documents-checked",
         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "content": [
             {
              "text": "Now that you have all the necessary info, you can fill out all the forms with your ",
              "type": "text"
             },
             {
              "text": "Order Due Date, Delivery Date, and Pricing Info",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": ". ",
              "type": "text"
             }
            ]
           }
          ]
         },
         "heading": "Fill out Order Forms",
         "component": "feature-group",
         "heading_level": "h3"
        },
        {
         "_uid": "eae83674-2e2a-4471-a72b-82988e161a5d",
         "icon": "envelope",
         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "content": [
             {
              "text": "Now it's time to distribute your forms to all your Sellers. Please ",
              "type": "text"
             },
             {
              "text": "make sure",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": " that your Sellers know when to return the Order Forms back to you.",
              "type": "text"
             }
            ]
           }
          ]
         },
         "heading": "Distribute Forms",
         "component": "feature-group",
         "heading_level": "h3"
        }
