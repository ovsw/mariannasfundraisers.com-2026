       "content": [
        {
         "_uid": "0af66110-3307-41ff-bd40-c49f17a39686",
         "title": "Hoagie Heroes",
         "eyebrow": "Our Goal",
         "component": "heading-group"
        },
        {
         "_uid": "f0f21a50-374d-4ae1-ab20-839088dd0f1a",
         "text": {
          "type": "doc",
          "content": [
           {
            "type": "paragraph",
            "content": [
             {
              "text": "We believe that ",
              "type": "text"
             },
             {
              "text": "a lot of good can come from doing small things",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             },
             {
              "text": ", so we take pride in making your community better one hoagie and pizza at a time.",
              "type": "text"
             }
            ]
           },
           {
            "type": "paragraph",
            "content": [
             {
              "text": "In 1981, the DelGrosso Family established Marianna’s Fundraisers as a way to help organizations meet their fundraising goals. Today, our mission is unchanged:",
              "type": "text"
             }
            ]
           },
           {
            "type": "paragraph",
            "content": [
             {
              "text": "Help groups raise funds for worthy causes: non-profit organizations, school groups/activities, churches, fire halls, and clubs.",
              "type": "text",
              "marks": [
               {
                "type": "bold"
               }
              ]
             }
            ]
           }
          ]
         },
         "component": "rich-text-basic"
