              "content": [
                {
                  "_uid": "286fd277-f8ae-429f-94b2-925f2e9dbb01",
                  "title": "Note",
                  "eyebrow": "Please",
                  "anchor_id": "",
                  "component": "heading-group"
                },
                {
                  "_uid": "f7c2f942-bf37-4c6d-8d29-1656c23bc36a",
                  "text": {
                    "type": "doc",
                    "attrs": {
                      "backgroundColor": null
                    },
                    "content": [
                      {
                        "type": "bullet_list",
                        "content": [
                          {
                            "type": "list_item",
                            "content": [
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "text": "State sales tax will be applied to your invoice for each hoagie if a ",
                                    "type": "text"
                                  },
                                  {
                                    "text": "Sales Tax Exempt Form",
                                    "type": "text",
                                    "marks": [
                                      {
                                        "type": "bold"
                                      }
                                    ]
                                  },
                                  {
                                    "text": " is not provided",
                                    "type": "text"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "list_item",
                            "content": [
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "text": "Employer Identification Number (EIN) cannot be accepted as Sales Tax Exempt Numbers",
                                    "type": "text"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "list_item",
                            "content": [
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "text": "Pizzas are not taxable",
                                    "type": "text"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "list_item",
                            "content": [
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "text": "With tax, hoagies would be $7.95",
                                    "type": "text"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "list_item",
                            "content": [
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "text": "Allegheny County deliveries are subject to an additional 1% sales tax",
                                    "type": "text"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
