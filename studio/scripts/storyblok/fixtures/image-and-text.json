                            "marks": [
                              {
                                "type": "styled",
                                "attrs": {
                                  "class": ""
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "paragraph"
                      },
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Food safety training is provided to all new employees and highlighted yearly for the entire staff.",
                            "type": "text",
                            "marks": [
                              {
                                "type": "styled",
                                "attrs": {
                                  "class": ""
                                }
