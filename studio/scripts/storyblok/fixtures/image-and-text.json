                  "text": {
                    "type": "doc",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Prepared in an FDA registered facility with strict sanitation and food safety standards.",
                            "type": "text"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Comprehensive food safety program that requires our staff to wear gloves, hair/beard nets, and white coats in our facility.",
