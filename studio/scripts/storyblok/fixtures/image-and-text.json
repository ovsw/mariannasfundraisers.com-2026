              "content": [
                {
                  "_uid": "84683ee6-3ca7-4a22-90e1-fcfb8ac27bd7",
                  "title": "We Take Care of the Rest",
                  "eyebrow": "That's it!",
                  "anchor_id": "",
                  "component": "heading-group"
                },
                {
                  "_uid": "47064d7e-e457-460f-8262-694eaf5cea86",
                  "text": {
                    "type": "doc",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "All that’s left is to receive your freshly prepared order, on the set date, at the location you specified.",
                            "type": "text",
                            "marks": [
                              {
                                "type": "styled",
                                "attrs": {
                                  "class": ""
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "We have tips and guides as well as detailed step-by-step instructions on how to prepare for the delivery and create the best experience on your event day! ",
                            "type": "text",
                            "marks": [
                              {
                                "type": "styled",
                                "attrs": {
                                  "class": ""
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Click the Step-by-Step Guide button to view our Fundraiser Guide Checklist & Helpful Videos! ",
                            "type": "text",
                            "marks": [
                              {
                                "type": "styled",
                                "attrs": {
                                  "class": ""
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "component": "rich-text-basic"
                },
