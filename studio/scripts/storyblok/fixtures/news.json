                {
                  "_uid": "b58c3cfa-6f5c-402f-923f-33312f3bf00e",
                  "title": "Hometown Favorite Sandwich",
                  "eyebrow": "Four-Time Winner!",
                  "component": "heading-group",
                  "heading_level": ""
                },
                {
                  "_uid": "08b9aac7-0d47-4d7a-8f14-ca2912c7ed27",
                  "text": {
                    "type": "doc",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Marianna’s Fundraisers has been awarded Hometown Favorite Sandwich once again for our famous Italian Hoagie—making this our fourth consecutive win!",
                            "type": "text"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Congratulations to our sister company, DelGrosso’s Park & Laguna Splash who was awarded Hometown Favorite Family Entertainment Venue! ",
                            "type": "text"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "A heartfelt thank you to everyone who voted and showed their support.",
                            "type": "text"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "We’re also grateful to The Altoona Mirror for hosting such a wonderful celebration to honor all the winners of the Hometown Favorite Awards!",
                            "type": "text"
                          }
                        ]
                      }
                    ]
                  },
                  "component": "rich-text-basic"
